# ==============================================
# Application Configuration
# ==============================================
PORT=5000
NODE_ENV=development

# Allowed CORS origins (comma-separated if multiple)
CLIENT_URL=http://localhost:4200

# ==============================================
# Email & SMTP Configuration
# ==============================================
# For testing, you can use Ethereal Email (https://ethereal.email)
# If EMAIL_USER and EMAIL_PASS are left blank in development,
# the app can automatically generate an Ethereal test account!
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_smtp_username_here
EMAIL_PASS=your_smtp_password_here
EMAIL_FROM="Notification App <no-reply@notificationapp.com>"

# ==============================================
# Feature Flags (Prepared for Person 2 Integration)
# ==============================================
FEATURE_WELCOME_EMAIL=true
FEATURE_VERIFICATION_EMAIL=true
FEATURE_PASSWORD_RESET_EMAIL=true
FEATURE_PROMOTIONAL_EMAIL=false

